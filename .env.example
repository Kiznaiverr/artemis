# YouTube URL-related tuning values now come from the API process env.

# How many peaks to return in the final output.
TOP_N=5

# Seconds added before each peak when building the clip range.
CLIP_PADDING_BEFORE=60

# Seconds added after each peak when building the clip range.
CLIP_PADDING_AFTER=60

# Rolling window size, in seconds, used to calculate comment activity.
WINDOW_SIZE=30

# Step size, in seconds, between each rolling window sample.
WINDOW_STEP=5
 
# Minimum distance, in seconds, allowed between two selected peaks.
PEAK_MIN_GAP_SECONDS=180

# Logger level: error, warn, info, or debug.
LOG_LEVEL=info

# Toggle AI features: set to true or false
ENABLE_AI=false

# yt-dlp authentication mode:
#  - none: no auth (default)
#  - browser: use --cookies-from-browser
#  - cookies-file: use --cookies <file>
YTDLP_AUTH_MODE=none
# Browser to use with --cookies-from-browser (when YTDLP_AUTH_MODE=browser)
YTDLP_AUTH_BROWSER=chrome
# Path to cookies file (when YTDLP_AUTH_MODE=cookies-file)
YTDLP_COOKIES_FILE=./cookies.txt

# ai provider apikey
api_provider=openrouter
openrouter_api_key=
sumopod_api_key=

# HTTP port for the Express API.
PORT=3000

# Cloudflare Tunnel token (optional). If set, the API will be exposed via Cloudflare Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here